{
  "manifest_version": 3,
  "name": "HackTools++",
  "version": "2.0.2",
  "description": "HackTools++: Repeater, Intruder, Decoder, and Scanner in DevTools. Capture, edit, and replay HTTP requests for testing.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "devtools_page": "devtools.html",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "scripting", "cookies"],
  "host_permissions": ["<all_urls>"]
}
